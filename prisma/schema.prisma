generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Production database is PostgreSQL (Neon). Local dev connects to the same Neon project via DATABASE_URL.

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MachineType {
  JCB
  EXCAVATOR
  BACKHOE_LOADER
  BULLDOZER
  LOADER
  TIPPER
  DUMP_TRUCK
  CRANE
  TRACTOR
  OTHER
}

enum MachineStatus {
  ACTIVE
  WORKING
  IDLE
  UNDER_MAINTENANCE
  BROKEN_DOWN
  RETIRED
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

enum JobSiteStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum BillingType {
  HOURLY
  DAILY
  FIXED
  QUANTITY
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
}

enum WorkSessionStatus {
  ACTIVE
  COMPLETED
}

enum MaintenanceType {
  SCHEDULED
  UNSCHEDULED
  REPAIR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  REPAIR
  OPERATOR_PAYMENT
  TRANSPORT
  SPARE_PARTS
  PERMITS
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model User {
  id            String     @id @default(cuid())
  name          String
  phone         String     @unique
  email         String?    @unique
  passwordHash  String
  role          UserRole   @default(OPERATOR)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  operatorProfile Operator?
  workSessions    WorkSession[]
  fuelLogs        FuelLog[]
  breakdowns      BreakdownReport[]
  expensesCreated Expense[]
  assignments     Assignment[]
  auditLogs       AuditLog[]
}

model Operator {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber  String?
  licenseExpiry  DateTime?
  joiningDate    DateTime?
  salaryType     SalaryType @default(MONTHLY)
  salaryAmount   Decimal?   @db.Decimal(12, 2)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Machine {
  id                      String        @id @default(cuid())
  name                    String
  registrationNumber      String        @unique
  machineType             MachineType
  manufacturer            String?
  model                   String?
  manufacturingYear       Int?
  purchaseDate            DateTime?
  purchasePrice           Decimal?      @db.Decimal(14, 2)
  currentHourMeter        Decimal       @default(0) @db.Decimal(10, 2)
  expectedFuelEfficiency  Decimal?      @db.Decimal(6, 2)
  serviceIntervalHours    Int?          @default(500)
  serviceIntervalDays     Int?
  lastServiceAt           DateTime?
  lastServiceMeter        Decimal?      @db.Decimal(10, 2)
  status                  MachineStatus @default(ACTIVE)
  notes                   String?
  photoUrl                String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  assignments       Assignment[]
  workSessions      WorkSession[]
  fuelLogs          FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  breakdowns        BreakdownReport[]
  expenses          Expense[]
  revenues          Revenue[]
}

model JobSite {
  id               String        @id @default(cuid())
  name             String
  clientName       String?
  clientPhone      String?
  address          String?
  latitude         Float?
  longitude        Float?
  startDate        DateTime?
  expectedEndDate  DateTime?
  status           JobSiteStatus @default(ACTIVE)
  billingType      BillingType   @default(HOURLY)
  rate             Decimal?      @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  assignments  Assignment[]
  workSessions WorkSession[]
  fuelLogs     FuelLog[]
  expenses     Expense[]
  revenues     Revenue[]
}

model Assignment {
  /// DB-level guard: partial unique index `assignment_one_active_per_machine`
  /// ensures at most one ACTIVE assignment per machine (see migration
  /// 20260822075708_fleet_rules_indexes).
  id         String           @id @default(cuid())
  machineId  String
  operatorId String
  jobSiteId  String
  assignedAt DateTime         @default(now())
  endedAt    DateTime?
  status     AssignmentStatus @default(ACTIVE)

  machine  Machine @relation(fields: [machineId], references: [id])
  operator User    @relation(fields: [operatorId], references: [id])
  jobSite  JobSite @relation(fields: [jobSiteId], references: [id])

  @@index([machineId])
  @@index([jobSiteId])
  @@index([status])
  @@index([operatorId, status])
}

model WorkSession {
  /// DB-level guards: partial unique indexes `work_session_one_active_per_machine`
  /// and `work_session_one_active_per_operator` ensure at most one ACTIVE
  /// session per machine and per operator (see migration
  /// 20260822075708_fleet_rules_indexes).
  id                 String            @id @default(cuid())
  machineId          String
  operatorId         String
  jobSiteId          String?
  startTime          DateTime          @default(now())
  endTime            DateTime?
  openingHourMeter   Decimal           @db.Decimal(10, 2)
  closingHourMeter   Decimal?          @db.Decimal(10, 2)
  workingHours       Decimal?          @db.Decimal(8, 2)
  idleHours          Decimal?          @db.Decimal(8, 2)
  fuelUsed           Decimal?          @db.Decimal(10, 2)
  notes              String?
  startPhotoUrl      String?
  endPhotoUrl        String?
  status             WorkSessionStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())

  machine  Machine  @relation(fields: [machineId], references: [id])
  operator User     @relation(fields: [operatorId], references: [id])
  jobSite  JobSite? @relation(fields: [jobSiteId], references: [id])

  @@index([machineId])
  @@index([operatorId])
  @@index([status])
  @@index([jobSiteId, status])
}

model FuelLog {
  id           String   @id @default(cuid())
  machineId    String
  operatorId   String
  jobSiteId    String?
  litres       Decimal  @db.Decimal(10, 2)
  costPerLitre Decimal? @db.Decimal(10, 2)
  totalCost    Decimal? @db.Decimal(12, 2)
  meterReading Decimal? @db.Decimal(10, 2)
  date         DateTime @default(now())
  receiptUrl   String?
  fuelStation  String?
  notes        String?
  createdAt    DateTime @default(now())

  machine  Machine  @relation(fields: [machineId], references: [id])
  operator User     @relation(fields: [operatorId], references: [id])
  jobSite  JobSite? @relation(fields: [jobSiteId], references: [id])

  @@index([machineId])
  @@index([date])
  @@index([machineId, date])
}

model MaintenanceRecord {
  id               String          @id @default(cuid())
  machineId        String
  serviceType      MaintenanceType @default(SCHEDULED)
  description      String?
  meterReading     Decimal?        @db.Decimal(10, 2)
  serviceDate      DateTime        @default(now())
  nextServiceHours Decimal?        @db.Decimal(10, 2)
  nextServiceDate  DateTime?
  partsCost        Decimal         @default(0) @db.Decimal(12, 2)
  laborCost        Decimal         @default(0) @db.Decimal(12, 2)
  totalCost        Decimal         @default(0) @db.Decimal(12, 2)
  serviceProvider  String?
  receiptUrl       String?
  notes            String?
  createdAt        DateTime        @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@index([serviceDate])
}

model BreakdownReport {
  id              String      @id @default(cuid())
  machineId       String
  operatorId      String
  severity        Severity    @default(MEDIUM)
  issue           String
  description     String?
  photoUrl        String?
  location        String?
  reportedAt      DateTime    @default(now())
  resolvedAt      DateTime?
  status          IssueStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime    @default(now())

  machine  Machine @relation(fields: [machineId], references: [id])
  operator User    @relation(fields: [operatorId], references: [id])

  @@index([machineId])
  @@index([status])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  machineId   String?
  jobSiteId   String?
  description String?
  date        DateTime        @default(now())
  receiptUrl  String?
  source      String?       // e.g. MANUAL, FUEL_LOG, MAINTENANCE — for reconciliation
  referenceId String?     // optional link to originating FuelLog/MaintenanceRecord
  createdById String?
  createdAt   DateTime        @default(now())

  machine   Machine? @relation(fields: [machineId], references: [id])
  jobSite   JobSite? @relation(fields: [jobSiteId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([date])
  @@index([jobSiteId, date])
}

model Revenue {
  id              String        @id @default(cuid())
  jobSiteId       String?
  machineId       String?
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(14, 2)
  amountReceived  Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  billingStart    DateTime?
  billingEnd      DateTime?
  clientName      String?
  notes           String?
  source          String?       // e.g. MANUAL, SITE_BILLING
  referenceId     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  jobSite JobSite? @relation(fields: [jobSiteId], references: [id])
  machine Machine? @relation(fields: [machineId], references: [id])

  @@index([paymentStatus])
}

/// Append-only trail for sensitive changes (financial entries, machine state
/// changes, operator lifecycle). Written via src/lib/audit.ts.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorRole String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}
